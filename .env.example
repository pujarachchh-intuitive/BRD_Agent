# Google AI Studio (Gemini Developer API) key.
# Get one at https://aistudio.google.com/apikey
# The one canonical variable this app reads (google-genai also accepts GEMINI_API_KEY as a
# fallback, but don't set both — it just prints a "using GOOGLE_API_KEY" warning on every call).
# After changing this, restart the backend process: `uvicorn --reload` watches *.py* files, not
# .env, so an already-running dev server keeps whatever key it started with.
GOOGLE_API_KEY=

# "development" | "staging" | "production" — also gates the session cookie's Secure flag (off in
# development so the browser will accept the cookie over plain http://localhost).
APP_ENV=development

# Signs session JWTs (webapp/auth/security.py). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=

# Databricks SQL warehouse connection (webapp/db.py) — used to read/write the users/projects/
# documents/generation_runs/audit_logs tables, and to upload generated artifacts to the
# brd_artifacts Volume, in dbx-ai-agents.brd_generator.
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=dbx-ai-agents
DATABRICKS_SCHEMA=brd_generator
DATABRICKS_VOLUME=brd_artifacts

# Only used by `python -m webapp.scripts.create_admin` — set these to skip the interactive
# prompts (e.g. in a non-interactive deploy step). Never commit real values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
